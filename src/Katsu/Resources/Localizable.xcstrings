    "Add a Mealie server. Connect Katsu to your Mealie server, then sign in to browse your recipes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mealie-Server hinzufügen. Verbinde Katsu mit deinem Mealie-Server und melde dich dann an, um deine Rezepte zu durchsuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a Mealie server. Connect Katsu to your Mealie server, then sign in to browse your recipes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agregar un servidor de Mealie. Conecta Katsu a tu servidor de Mealie y luego inicia sesión para explorar tus recetas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mealie サーバを追加。Katsu を Mealie サーバに接続し、サインインしてレシピを閲覧します。"
