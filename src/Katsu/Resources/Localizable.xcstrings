        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir un servidor de Mealie. Conecta Katsu a tu servidor de Mealie y luego inicia sesión para explorar tus recetas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mealie サーバを追加。Katsu を Mealie サーバに接続し、サインインしてレシピを閲覧します。"
          }
        }
