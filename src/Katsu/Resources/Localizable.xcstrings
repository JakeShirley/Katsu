    "Your API token was rejected. Paste a new token to restore syncing with this Mealie server. Offline recipes stay available on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein API-Token wurde abgelehnt. Füge ein neues Token ein, um die Synchronisierung mit diesem Mealie-Server wiederherzustellen. Offline-Rezepte bleiben auf diesem Gerät verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your API token was rejected. Paste a new token to restore syncing with this Mealie server. Offline recipes stay available on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rechazó tu token de API. Pega un token nuevo para restaurar la sincronización con este servidor de Mealie. Las recetas sin conexión seguirán disponibles en este dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API トークンが拒否されました。この Mealie サーバとの同期を復元するには、新しいトークンを貼り付けてください。オフラインレシピはこのデバイスで引き続き利用できます。"
          }
        }
      }
    },
    "Your photos never leave this device until you import the reviewed recipe." : {
      "extractionState" : "manual",
