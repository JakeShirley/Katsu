    "Create a long-lived token in Mealie under your profile's API Tokens page. Use this when your server signs in through a reverse proxy or doesn't allow password login." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle in Mealie auf der Seite „API-Tokens“ deines Profils ein langlebiges Token. Verwende es, wenn dein Server die Anmeldung über einen Reverse Proxy abwickelt oder keine Passwortanmeldung erlaubt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a long-lived token in Mealie under your profile's API Tokens page. Use this when your server signs in through a reverse proxy or doesn't allow password login."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un token de larga duración en Mealie, en la página de tokens de API de tu perfil. Úsalo cuando tu servidor inicie sesión mediante un proxy inverso o no permita iniciar sesión con contraseña."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mealie のプロフィールにある「API トークン」ページで長期間有効なトークンを作成してください。サーバがリバースプロキシ経由でサインインする場合や、パスワードでのサインインが許可されていない場合に使用します。"
          }
        }
      }
    },
